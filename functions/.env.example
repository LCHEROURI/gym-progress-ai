# Server-side Gemini configuration. Copy this file to functions/.env
# (gitignored) and fill in values. These never ship in the browser bundle.
#
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default: gemini-2.5-flash (kept in sync with
# DEFAULT_MODEL in src/coach/explain.ts).
GEMINI_MODEL=
